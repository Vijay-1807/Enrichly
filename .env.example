# Copy to .env and fill in. Never commit real secrets.
# docker compose reads this file automatically.

# Required in production: random 32+ char string.
JWT_SECRET=change-me-to-a-long-random-string-32-chars-min

# Where the browser reaches the API (used by Next.js at build time).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Allowed browser origin(s) for CORS, comma-separated.
FRONTEND_URL=http://localhost:3000

# Local API default (overridden by compose to Host=db...).
ConnectionStrings__Default=Host=localhost;Port=5432;Database=enrichly_jobs;Username=postgres;Password=postgres

# Optional tuning
# Worker__PollIntervalSeconds=2
# Worker__StaleTimeoutSeconds=120
# Scheduler__IntervalSeconds=15

# For hosted Postgres (Render/Railway/Neon), use one URL instead:
# DATABASE_URL=postgresql://user:pass@host:5432/enrichly_jobs
